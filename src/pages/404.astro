---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <main
    class="min-h-screen flex flex-col items-center justify-center text-center"
  >
    <h1 class="text-8xl font-bold text-[var(--sec)] mb-4">404</h1>
    <p class="text-xl text-[var(--white-icon)] mb-8">
      Oops! The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="px-6 py-3 bg-[var(--sec)] font-medium text-white rounded-lg hover:opacity-90 transition-opacity"
    >
      Go back home
    </a>
  </main>
</Layout>
